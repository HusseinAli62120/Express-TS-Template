# Your environment (development, test, production)
NODE_ENV=development

# DB
DATABASE_URL='yourDatabaseUrl'

# Auth Secret key
BETTER_AUTH_SECRET=32RandomString

# Backend URL
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Used only to display the environment
PORT=3000
BACKEND_URL=http://localhost

# Frontend Url
FRONTEND_URL=yourFrontendUrl
