{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend for kanbanBoard",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "dev": "dotenv -e .env.development -- nodemon index.ts",
    "test": "dotenv -e .env.test -- nodemon index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate:dev": "dotenv -e .env.development -- prisma generate ",
    "db:push:dev": "dotenv -e .env.development -- prisma db push ",
    "db:studio:dev": "dotenv -e .env.development -- prisma studio ",
    "db:generate:test": "dotenv -e .env.test -- prisma generate ",
    "db:push:test": "dotenv -e .env.test -- prisma db push ",
    "db:studio:test": "dotenv -e .env.test -- prisma studio ",
    "db:generate:production": "dotenv -e .env.production -- prisma generate ",
    "db:push:production": "dotenv -e .env.production -- prisma db push ",
    "db:studio:production": "dotenv -e .env.production -- prisma studio "
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
