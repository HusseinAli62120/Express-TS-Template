generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        String     @id @default(uuid())
  userName  String?  @unique
  email     String?  @unique
  password  String
  role      Role       @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum Role{
  USER
  ADMIN
  SUPER_ADMIN
}